+  // GPL build: synchronous per-device file writers (no worker thread).
+  // Each entry owns its file + text stream; created lazily on first data,
+  // closed by closeFile() or on device disconnect.
+  struct GplDeviceFile {
+    std::unique_ptr<QFile> file;
+    std::unique_ptr<QTextStream> stream;
+  };
+  std::unordered_map<int, GplDeviceFile> m_gplDeviceFiles;
+  void gplCreateFile(int deviceId);
